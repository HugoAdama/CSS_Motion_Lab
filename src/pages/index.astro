---
// index.astro — Página principal del catálogo CSS Motion Lab
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FilterBar from '../components/FilterBar.astro';
import AnimationCard from '../components/AnimationCard.astro';
import Pagination from '../components/Pagination.astro';
import Footer from '../components/Footer.astro';
import Toast from '../components/Toast.astro';
import type { AnimationDefinition } from '../types';
import { animations, categories } from '../data/animations.js';
import '../styles/global.css';

const typedAnimations = animations as unknown as AnimationDefinition[];
const totalCount = typedAnimations.length;
const patternsCount = typedAnimations.filter((a) => a.category === 'Patrones UI').length;
const atomicCount = typedAnimations.filter((a) => a.category !== 'Patrones UI').length;

const categoryCounts = categories.reduce<Record<string, number>>((acc, cat) => {
  acc[cat] = cat === 'Todas' ? totalCount : typedAnimations.filter((a) => a.category === cat).length;
  return acc;
}, {});
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="CSS Motion Lab — Biblioteca interactiva para consultar, calibrar, entender y copiar animaciones y patrones compuestos de CSS con código coordinado listo para producción."
    />
    <meta name="theme-color" content="#0d0e17" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <title>CSS Motion Lab — Catálogo y Laboratorio Interactivo de Animaciones CSS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- 1. Encabezado global y accesibilidad -->
    <Header />

    <!-- 2. Contenido principal -->
    <main id="inicio">
      <Hero
        totalCount={totalCount}
        patternsCount={patternsCount}
        atomicCount={atomicCount}
      />

      <section class="library-section" id="biblioteca" aria-labelledby="library-title">
        <FilterBar
          categories={categories}
          categoryCounts={categoryCounts}
          totalCount={totalCount}
        />

        <div class="animation-grid" data-animation-grid>
          {typedAnimations.map((animation) => <AnimationCard animation={animation} />)}
        </div>

        <div class="empty-state" data-empty-state hidden>
          <div class="empty-state-icon" aria-hidden="true">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <h3>No se encontraron animaciones</h3>
          <p>No hay resultados que coincidan con tus criterios de búsqueda o filtro.</p>
          <button class="hero-btn hero-btn--secondary" type="button" data-reset-filters>
            Restablecer filtros
          </button>
        </div>

        <Pagination />
      </section>
    </main>

    <!-- 3. Pie de página -->
    <Footer />

    <!-- 4. Notificación flotante accesible -->
    <Toast />

    <!-- 5. Barra flotante del Creador de Paquete Personalizado (Custom Bundle Dock) -->
    <aside class="bundle-dock" data-bundle-dock hidden aria-label="Paquete CSS personalizado">
      <div class="bundle-dock-inner">
        <div class="bundle-dock-info">
          <div class="bundle-dock-badge">
            <span class="bundle-counter-pill" data-bundle-count>0</span>
          </div>
          <div class="bundle-dock-text">
            <strong>Mi Selección de Animaciones</strong>
            <span>Genera un archivo CSS único con tus animaciones</span>
          </div>
        </div>
        <div class="bundle-dock-actions">
          <button class="bundle-action-btn bundle-action-btn--primary" type="button" data-bundle-download title="Descargar paquete como archivo .css">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Descargar .CSS</span>
          </button>
          <button class="bundle-action-btn bundle-action-btn--secondary" type="button" data-bundle-copy title="Copiar todo el CSS unificado al portapapeles">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span>Copiar Todo</span>
          </button>
          <button class="bundle-action-btn bundle-action-btn--ghost" type="button" data-bundle-clear title="Vaciar selección">
            <span>Limpiar</span>
          </button>
        </div>
      </div>
    </aside>

    <!-- 6. Botón flotante Volver Arriba -->
    <button class="back-to-top" data-back-to-top type="button" aria-label="Volver arriba de la galería" title="Volver al inicio de la galería">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <!-- 7. Modal accesible de Atajos de Teclado -->
    <dialog class="shortcuts-dialog" data-shortcuts-dialog aria-labelledby="shortcuts-modal-title">
      <div class="shortcuts-dialog__content">
        <div class="shortcuts-dialog__header">
          <h3 id="shortcuts-modal-title">Atajos de Teclado del Laboratorio</h3>
          <button class="shortcuts-close-btn" type="button" data-shortcuts-close aria-label="Cerrar modal">&times;</button>
        </div>
        <div class="shortcuts-list">
          <div class="shortcut-item">
            <kbd class="shortcut-key">R</kbd>
            <span>Reproducir todas las animaciones visibles</span>
          </div>
          <div class="shortcut-item">
            <kbd class="shortcut-key">M</kbd>
            <span>Alternar modo de movimiento reducido (accesibilidad)</span>
          </div>
          <div class="shortcut-item">
            <kbd class="shortcut-key">/</kbd>
            <span>Enfocar el buscador en tiempo real</span>
          </div>
          <div class="shortcut-item">
            <div class="shortcut-keys-group">
              <kbd class="shortcut-key">&larr;</kbd>
              <kbd class="shortcut-key">&rarr;</kbd>
            </div>
            <span>Navegar a la página anterior o siguiente</span>
          </div>
          <div class="shortcut-item">
            <kbd class="shortcut-key">?</kbd>
            <span>Abrir / cerrar esta guía de atajos rápidos</span>
          </div>
          <div class="shortcut-item">
            <kbd class="shortcut-key">Esc</kbd>
            <span>Cerrar paneles de código, modales o limpiar búsqueda</span>
          </div>
        </div>
      </div>
    </dialog>

    <!-- 8. Script cliente empaquetado por Vite -->
    <script src="../scripts/main.ts"></script>
  </body>
</html>
