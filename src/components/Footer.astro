---
// Footer.astro — Pie de página con créditos oficiales, enlace al repositorio y logotipo del laboratorio
---

<footer class="site-footer">
  <div class="footer-inner">
    <!-- Columna 1: Marca con icono oficial del sitio -->
    <div class="footer-brand-col">
      <a class="brand brand--footer" href="#inicio" aria-label="CSS Motion Lab, ir al inicio">
        <span class="brand-mark" aria-hidden="true">
          <i class="bar-1"></i>
          <i class="bar-2"></i>
          <i class="bar-3"></i>
        </span>
        <span class="brand-text">CSS <strong>Motion Lab</strong></span>
      </a>
      <p class="footer-copy">
        Laboratorio interactivo para experimentar, calibrar y reutilizar animaciones CSS nativas y patrones de UI listos para producción.
      </p>
    </div>

    <!-- Columna 2: Créditos de autoría requeridos "Realizado por Hugo Adama" -->
    <div class="footer-credits-col">
      <div class="creator-card">
        <span class="creator-label">Desarrollo y Diseño:</span>
        <a class="creator-link" href="https://github.com/HugoAdama" target="_blank" rel="noreferrer" title="Perfil de GitHub de Hugo Adama">
          <span class="creator-avatar" aria-hidden="true">HA</span>
          <div class="creator-info">
            <span class="creator-by">Realizado por</span>
            <strong class="creator-name">Hugo Adama</strong>
          </div>
          <svg class="creator-ext-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- Columna 3: Enlace al Repositorio y Navegación -->
    <div class="footer-actions-col">
      <a class="footer-repo-btn" href="https://github.com/HugoAdama/CSS_Motion_Lab" target="_blank" rel="noreferrer" title="Ver repositorio oficial de código en GitHub">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span>Repositorio en GitHub</span>
        <span class="footer-arrow-ext" aria-hidden="true">&nearr;</span>
      </a>

      <div class="footer-bottom-links">
        <a class="footer-sublink" href="#inicio">Volver arriba &uarr;</a>
        <span class="footer-dot" aria-hidden="true">&middot;</span>
        <a class="footer-sublink" href="#biblioteca">Catálogo</a>
      </div>
    </div>
  </div>
</footer>
