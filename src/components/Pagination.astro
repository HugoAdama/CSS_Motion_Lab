---
// Pagination.astro — Paginación accesible para el catálogo (6 elementos por página)
---

<nav class="pagination-bar" data-pagination-bar aria-label="Navegación de páginas del catálogo">
  <div class="pagination-left">
    <div class="pagination-info" data-pagination-info aria-live="polite">
      Mostrando 1–6 de 120 animaciones
    </div>
    <div class="pagination-size-selector" role="group" aria-label="Animaciones por página">
      <span class="pagination-size-label">Por página:</span>
      <div class="pagination-size-pills">
        <button class="page-size-btn is-active" type="button" data-page-size="6" title="Mostrar 6 animaciones por página">6</button>
        <button class="page-size-btn" type="button" data-page-size="12" title="Mostrar 12 animaciones por página">12</button>
        <button class="page-size-btn" type="button" data-page-size="24" title="Mostrar 24 animaciones por página">24</button>
        <button class="page-size-btn" type="button" data-page-size="all" title="Mostrar todas las animaciones en una sola página">Todas</button>
      </div>
    </div>
  </div>

  <div class="pagination-controls">
    <button
      class="pagination-btn pagination-btn--nav"
      type="button"
      data-page-prev
      aria-label="Ir a la página anterior"
      disabled
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      <span>Anterior</span>
    </button>

    <div class="pagination-numbers" data-pagination-numbers role="group" aria-label="Seleccionar número de página">
      <!-- Los botones numéricos se generan y actualizan dinámicamente -->
    </div>

    <button
      class="pagination-btn pagination-btn--nav"
      type="button"
      data-page-next
      aria-label="Ir a la página siguiente"
    >
      <span>Siguiente</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</nav>
