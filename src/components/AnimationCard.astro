---
const { animation } = Astro.props;

const initialCss = animation.generateCss(animation.defaultDuration, animation.defaultTiming, animation.defaultStaggerDelay || 0.1);
const initialFullExample = `<!-- HTML -->\n${animation.htmlSnippet}\n\n<!-- CSS -->\n<style>\n${initialCss}\n</style>`;
---

<article
  class="animation-card"
  data-animation-card
  data-category={animation.category}
  data-name={animation.name.toLowerCase()}
  data-id={animation.id}
  data-default-duration={animation.defaultDuration}
  data-default-timing={animation.defaultTiming}
  data-default-stagger={animation.defaultStaggerDelay || 0.1}
>
  <div class="animation-card__preview">
    <div class="preview-top-meta">
      <span class="preview-tag preview-tag--selector" title="Selector CSS utilizado">{animation.targetSelector}</span>
      <span class="preview-tag preview-tag--category">{animation.category}</span>
    </div>

    <div class:list={['demo-stage', animation.previewClass]} data-demo-stage aria-hidden="true">
      {animation.id === 'fade-in' && (
        <div class="toast-card is-playing" data-motion-target>
          <span class="toast-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </span>
          <div class="toast-info">
            <strong>Guardado con éxito</strong>
            <span>Tus cambios han sido sincronizados</span>
          </div>
        </div>
      )}

      {animation.id === 'slide-in' && (
        <div class="nav-chip is-playing" data-motion-target>
          <span class="chip-dot"></span>
          <span class="chip-text">Panel lateral activo</span>
          <span class="chip-arrow">&rarr;</span>
        </div>
      )}

      {animation.id === 'bounce' && (
        <div class="bell-badge is-playing" data-motion-target>
          <div class="bell-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
          </div>
          <span class="bell-count">3</span>
        </div>
      )}

      {animation.id === 'pulse' && (
        <div class="status-beacon is-playing" data-motion-target>
          <span class="beacon-ring"></span>
          <span class="beacon-dot"></span>
          <span class="beacon-label">SISTEMA ONLINE</span>
        </div>
      )}

      {animation.id === 'shake' && (
        <div class="input-alert is-playing" data-motion-target>
          <span class="alert-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          </span>
          <span class="alert-text">Error de acceso</span>
        </div>
      )}

      {animation.id === 'spinner' && (
        <div class="spinner-stage" data-motion-target>
          <div class="spinner-ring is-playing" role="status" aria-label="Cargando"></div>
        </div>
      )}

      {animation.id === 'typing' && (
        <div class="terminal-box is-playing" data-motion-target>
          <div class="terminal-bar">
            <span></span><span></span><span></span>
          </div>
          <div class="terminal-body">
            <span class="terminal-prompt">$</span>
            <span class="typing-text">console.log("Motion!");</span>
          </div>
        </div>
      )}

      {animation.id === 'hover-lift' && (
        <div class="card-interactive" tabindex="0" data-motion-target>
          <div class="card-glow"></div>
          <span class="card-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          </span>
          <strong>Pasa el cursor</strong>
          <small>o presiona Tab</small>
        </div>
      )}

      {/* 9. Staggered reveal */}
      {animation.id === 'staggered-reveal' && (
        <ul class="stagger-list is-playing" data-motion-target>
          <li class="stagger-item" style="--stagger-index: 0;">
            <span class="stagger-bullet">1</span>
            <span class="stagger-text">Primer elemento cargado</span>
          </li>
          <li class="stagger-item" style="--stagger-index: 1;">
            <span class="stagger-bullet">2</span>
            <span class="stagger-text">Segundo elemento cargado</span>
          </li>
          <li class="stagger-item" style="--stagger-index: 2;">
            <span class="stagger-bullet">3</span>
            <span class="stagger-text">Tercer elemento cargado</span>
          </li>
        </ul>
      )}

      {/* 10. Toast Lifecycle */}
      {animation.id === 'toast-lifecycle' && (
        <div class="toast-lifecycle-preview" data-motion-target>
          <div class="toast-banner is-playing">
            <span class="toast-badge">Info</span>
            <div class="toast-msg">
              <strong>Proceso finalizado</strong>
              <p>El archivo se descargó correctamente.</p>
            </div>
            <button class="toast-close-btn" type="button" aria-label="Cerrar notificación">&times;</button>
          </div>
        </div>
      )}

      {/* 11. Skeleton Shimmer */}
      {animation.id === 'skeleton-shimmer' && (
        <div class="skeleton-card is-playing" data-motion-target role="status" aria-label="Cargando contenido">
          <div class="skeleton-avatar"></div>
          <div class="skeleton-lines">
            <div class="skeleton-line skeleton-line--title"></div>
            <div class="skeleton-line skeleton-line--body"></div>
          </div>
        </div>
      )}

      {/* 12. Accordion */}
      {animation.id === 'accordion' && (
        <div class="accordion-item is-open" data-motion-target data-accordion-widget>
          <button class="accordion-trigger" type="button" aria-expanded="true">
            <span>¿Cómo integrar esta animación?</span>
            <span class="accordion-arrow">&darr;</span>
          </button>
          <div class="accordion-content">
            <div class="accordion-inner">
              <p>Copia el bloque completo de HTML y CSS coordinados y pégalo directamente en tu proyecto.</p>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>

  <div class="animation-card__body">
    <div class="card-info">
      <div class="card-header-row">
        <h3>{animation.name}</h3>
        <span class={`cost-badge cost-badge--${animation.renderCostType}`} title={animation.costExplanation}>
          {animation.renderCost}
        </span>
      </div>
      <p>{animation.description}</p>
      <div class="tech-specs">
        <span class="tech-spec-label">Propiedades:</span>
        <code class="tech-spec-code">{animation.properties}</code>
      </div>
    </div>

    <!-- Controles de Aprendizaje y Calibración en tiempo real -->
    <div class="card-tuner">
      <div class="tuner-heading">
        <span class="tuner-title">Calibrar parámetros:</span>
        <button class="tuner-reset-btn" type="button" data-reset-tuning aria-label={`Restablecer parámetros de ${animation.name}`}>
          Restablecer
        </button>
      </div>

      <div class="tuner-row">
        <label class="tuner-field">
          <span class="tuner-label">
            Duración: <strong data-duration-value>{animation.defaultDuration}s</strong>
          </span>
          <input
            type="range"
            class="tuner-range"
            min="0.2"
            max={animation.id === 'toast-lifecycle' ? '5.0' : '3.0'}
            step="0.05"
            value={animation.defaultDuration}
            data-duration-input
            aria-label={`Duración en segundos para ${animation.name}`}
          />
        </label>

        <label class="tuner-field">
          <span class="tuner-label">Curva (timing):</span>
          <select class="tuner-select" data-timing-select aria-label={`Curva de aceleración para ${animation.name}`}>
            {animation.timingOptions.map((opt) => (
              <option value={opt} selected={opt === animation.defaultTiming}>{opt}</option>
            ))}
          </select>
        </label>

        {animation.hasStaggerControl && (
          <label class="tuner-field tuner-field--full">
            <span class="tuner-label">
              Retraso escalonado (delay): <strong data-stagger-value>{(animation.defaultStaggerDelay || 0.1) * 1000}ms</strong>
            </span>
            <input
              type="range"
              class="tuner-range"
              min="0.04"
              max="0.30"
              step="0.02"
              value={animation.defaultStaggerDelay || 0.1}
              data-stagger-input
              aria-label={`Retraso entre elementos para ${animation.name}`}
            />
          </label>
        )}
      </div>
    </div>

    <div class="animation-card__actions">
      <button class="button button--quiet" type="button" data-replay aria-label={`Reproducir animación ${animation.name}`}>
        <span class="replay-icon" aria-hidden="true">&#x21bb;</span>
        <span>Reproducir</span>
      </button>

      {animation.id === 'accordion' && (
        <button class="button button--toggle-accordion" type="button" data-toggle-accordion-demo aria-label="Abrir o cerrar acordeón de prueba">
          <span>Alternar abrir/cerrar</span>
        </button>
      )}

      <button
        class="button button--copy-full"
        type="button"
        data-copy-full
        title="Copiar HTML y CSS coordinados con las mismas clases para pegar y usar de inmediato"
        aria-label={`Copiar ejemplo completo de ${animation.name}`}
      >
        <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        <span data-copy-full-text>Copiar ejemplo completo</span>
      </button>

      <button class="button button--code" type="button" data-toggle-code aria-expanded="false" aria-label={`Ver código de ${animation.name}`}>
        <span>Código</span>
        <span class="chevron-icon" aria-hidden="true">⌄</span>
      </button>
    </div>

    <div class="code-panel" data-code-panel hidden>
      <div class="code-panel__tabs">
        <div class="tab-buttons" role="tablist">
          <button class="tab-btn is-active" type="button" data-tab="css" role="tab" aria-selected="true">CSS</button>
          <button class="tab-btn" type="button" data-tab="html" role="tab" aria-selected="false">HTML</button>
          <button class="tab-btn" type="button" data-tab="full" role="tab" aria-selected="false">Completo (HTML + CSS)</button>
        </div>
        <button class="copy-button" type="button" data-copy aria-label="Copiar código actual al portapapeles">
          <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span data-copy-text>Copiar</span>
        </button>
      </div>

      <div class="code-view" data-code-view="css">
        <pre><code data-code-css>{initialCss}</code></pre>
      </div>
      <div class="code-view" data-code-view="html" hidden>
        <pre><code data-code-html>{animation.htmlSnippet}</code></pre>
      </div>
      <div class="code-view" data-code-view="full" hidden>
        <pre><code data-code-full>{initialFullExample}</code></pre>
      </div>

      <p class="copy-status" data-copy-status aria-live="polite"></p>
    </div>
  </div>
</article>
