---
import type { AnimationDefinition } from '../types';

interface Props {
  animation: AnimationDefinition;
}

const { animation } = Astro.props;

const initialCss = animation.generateCss(animation.defaultDuration, animation.defaultTiming, animation.defaultStaggerDelay || 0.1);
const initialFullExample = `<!-- HTML -->\n${animation.htmlSnippet}\n\n<!-- CSS -->\n<style>\n${initialCss}\n</style>`;
const initialTailwind = `// tailwind.config.js — Configuración para ${animation.name}\nmodule.exports = {\n  theme: {\n    extend: {\n      animation: {\n        '${animation.id}': '${animation.id} ${animation.defaultDuration}s ${animation.defaultTiming} infinite',\n      },\n      keyframes: {\n        '${animation.id}': {\n          /* Clases y keyframes coordinados de ${animation.name} */\n        },\n      },\n    },\n  },\n};\n\n<!-- Clases arbitrarias en Tailwind CSS -->\n<div class="animate-[${animation.id}_${animation.defaultDuration}s_${animation.defaultTiming}]">\n  <!-- ${animation.targetSelector} -->\n</div>`;
---

<article
  class="animation-card"
  data-animation-card
  data-category={animation.category}
  data-cost-type={animation.renderCostType}
  data-name={animation.name.toLowerCase()}
  data-id={animation.id}
  data-default-duration={animation.defaultDuration}
  data-default-timing={animation.defaultTiming}
  data-default-stagger={animation.defaultStaggerDelay || 0.1}
>
  <div class="animation-card__preview">
    <div class="preview-top-meta">
      <span class="preview-tag preview-tag--selector" title="Selector CSS utilizado">{animation.targetSelector}</span>
      <div class="preview-meta-right">
        <button class="stage-grid-btn" type="button" data-stage-grid-btn title="Alternar cuadrícula técnica de fondo" aria-label="Alternar cuadrícula de fondo">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="12" y1="3" x2="12" y2="21"></line>
          </svg>
        </button>
        <span class="preview-tag preview-tag--category">{animation.category}</span>
      </div>
    </div>

    <div class:list={['demo-stage', animation.previewClass]} data-demo-stage aria-hidden="true">
      <Fragment set:html={animation.previewHtml} />
    </div>
  </div>

  <div class="animation-card__body">
    <div class="card-info">
      <div class="card-header-row">
        <h3>{animation.name}</h3>
        <span class={`cost-badge cost-badge--${animation.renderCostType}`} title={animation.costExplanation}>
          {animation.renderCost}
        </span>
      </div>
      <p>{animation.description}</p>
      <div class="tech-specs">
        <span class="tech-spec-label">Propiedades:</span>
        <code class="tech-spec-code">{animation.properties}</code>
      </div>
    </div>

    <!-- Controles de Aprendizaje y Calibración en tiempo real -->
    <div class="card-tuner" data-card-tuner>
      <div class="tuner-heading">
        <span class="tuner-title">Calibrar parámetros:</span>
        <button class="tuner-reset-btn" type="button" data-reset-tuning aria-label={`Restablecer parámetros de ${animation.name}`}>
          Restablecer
        </button>
      </div>

      <div class="tuner-row">
        <label class="tuner-field">
          <span class="tuner-label">
            Duración: <strong data-duration-value>{animation.defaultDuration}s</strong>
          </span>
          <input
            type="range"
            class="tuner-range"
            min="0.2"
            max={animation.id === 'toast-lifecycle' ? '5.0' : '3.0'}
            step="0.05"
            value={animation.defaultDuration}
            data-duration-input
            aria-label={`Duración en segundos para ${animation.name}`}
          />
        </label>

        <label class="tuner-field">
          <span class="tuner-label">Curva (timing):</span>
          <select class="tuner-select" data-timing-select aria-label={`Curva de aceleración para ${animation.name}`}>
            {animation.timingOptions.map((opt) => (
              <option value={opt} selected={opt === animation.defaultTiming}>{opt}</option>
            ))}
          </select>
        </label>

        <!-- Visualizador interactivo de Curva Bézier en vivo con referencia -->
        <div class="tuner-curve-box" data-curve-container title="Curva Bézier de aceleración vs referencia lineal">
          <div class="curve-graph-wrap">
            <svg class="curve-svg" viewBox="0 0 100 60" aria-hidden="true">
              <!-- Rejilla y ejes -->
              <line x1="10" y1="50" x2="90" y2="50" class="curve-axis" />
              <line x1="10" y1="50" x2="10" y2="10" class="curve-axis" />
              <line x1="10" y1="10" x2="90" y2="10" class="curve-grid-line" />
              <line x1="90" y1="50" x2="90" y2="10" class="curve-grid-line" />
              <!-- Línea de referencia lineal (comparativa) -->
              <line x1="10" y1="50" x2="90" y2="10" class="curve-ref-line" />
              <!-- Líneas tangentes -->
              <path class="curve-tangent" data-curve-tangent d="" />
              <!-- Curva Bézier cúbica activa -->
              <path class="curve-path" data-curve-path d="M 10 50 C 26 10, 40 10, 90 10" />
              <!-- Puntos de control -->
              <circle class="curve-cp" data-curve-cp1 cx="26" cy="10" r="2.5" />
              <circle class="curve-cp" data-curve-cp2 cx="40" cy="10" r="2.5" />
              <!-- Bolita animada sobre el eje -->
              <circle class="curve-dot" data-curve-dot cx="10" cy="50" r="3.5" />
            </svg>
          </div>
          <div class="curve-caption">
            <div class="curve-badge-row">
              <span class="curve-badge">Curva Bézier:</span>
              <span class="curve-ref-hint" title="Línea punteada: referencia lineal (linear)">ref. linear</span>
            </div>
            <code class="curve-val" data-curve-name>{animation.defaultTiming}</code>
          </div>
        </div>

        {animation.hasStaggerControl && (
          <label class="tuner-field tuner-field--full">
            <span class="tuner-label">
              Retraso escalonado (delay): <strong data-stagger-value>{(animation.defaultStaggerDelay || 0.1) * 1000}ms</strong>
            </span>
            <input
              type="range"
              class="tuner-range"
              min="0.04"
              max="0.30"
              step="0.02"
              value={animation.defaultStaggerDelay || 0.1}
              data-stagger-input
              aria-label={`Retraso entre elementos para ${animation.name}`}
            />
          </label>
        )}
      </div>
    </div>

    <!-- Barra de acciones unificada y ergonómica -->
    <div class="animation-card__actions">
      <div class="actions-row actions-row--primary">
        <div class="actions-playback-group">
          <button class="button button--replay button--primary-action" type="button" data-replay aria-label={`Reproducir animación ${animation.name}`}>
            <span class="replay-icon" aria-hidden="true">&#x21bb;</span>
            <span>Reproducir</span>
          </button>

          <button class="button button--subtle button--pause" type="button" data-pause-toggle title="Pausar o reanudar animación" aria-label={`Pausar animación ${animation.name}`}>
            <span class="pause-icon" aria-hidden="true">⏸</span>
            <span class="pause-text">Pausar</span>
          </button>

          {animation.id === 'accordion' && (
            <button class="button button--subtle button--toggle-accordion" type="button" data-toggle-accordion-demo aria-label="Abrir o cerrar acordeón de prueba">
              <span>Alternar</span>
            </button>
          )}

          {animation.id === 'flip-card' && (
            <button class="button button--subtle button--toggle-flip" type="button" data-toggle-flip-demo aria-label="Alternar giro 3D de la tarjeta">
              <span>Girar 3D</span>
            </button>
          )}
        </div>

        <button class="button button--code-pill" type="button" data-toggle-code aria-expanded="false" aria-label={`Ver código de ${animation.name}`}>
          <svg class="code-btn-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          <span>Código</span>
          <span class="chevron-icon" aria-hidden="true">⌄</span>
        </button>
      </div>

      <div class="actions-row actions-row--secondary">
        <div class="quick-tools-group">
          <!-- Botón Favorito -->
          <button
            class="action-icon-btn action-icon-btn--favorite"
            type="button"
            data-favorite-toggle
            title="Guardar en favoritos"
            aria-label={`Guardar ${animation.name} en favoritos`}
          >
            <svg class="star-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span class="sr-only">Favorito</span>
          </button>

          <button
            class="action-icon-btn"
            type="button"
            data-copy-full
            title="Copiar HTML y CSS coordinados"
            aria-label={`Copiar ejemplo completo de ${animation.name}`}
          >
            <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span class="sr-only" data-copy-full-text>Copiar</span>
          </button>

          <!-- Botón 1-clic: Abrir en CodePen -->
          <button
            class="action-icon-btn"
            type="button"
            data-open-codepen
            title="Abrir este ejemplo en CodePen"
            aria-label={`Abrir ${animation.name} en CodePen`}
          >
            <svg class="codepen-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"></polygon>
              <line x1="12" y1="22" x2="12" y2="15.5"></line>
              <polyline points="22 8.5 12 15.5 2 8.5"></polyline>
              <polyline points="2 15.5 12 8.5 22 15.5"></polyline>
              <line x1="12" y1="2" x2="12" y2="8.5"></line>
            </svg>
            <span class="sr-only">CodePen</span>
          </button>

          <!-- Botón Colección / Bundle Builder -->
          <button
            class="action-icon-btn action-icon-btn--bundle"
            type="button"
            data-bundle-toggle
            title="Añadir a mi paquete CSS personalizado"
            aria-label={`Añadir ${animation.name} a mi paquete`}
          >
            <span class="bundle-check-icon" aria-hidden="true">+</span>
            <span class="sr-only bundle-btn-text">Paquete</span>
          </button>
        </div>

        <button class="button button--subtle button--tuner-toggle" type="button" data-toggle-tuner-card title="Mostrar u ocultar calibrador en modo compacto" aria-label="Alternar calibrador">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        </button>
      </div>
    </div>

    <div class="code-panel" data-code-panel hidden>
      <div class="code-panel__tabs">
        <div class="tab-buttons" role="tablist">
          <button class="tab-btn is-active" type="button" data-tab="css" role="tab" aria-selected="true">CSS</button>
          <button class="tab-btn" type="button" data-tab="html" role="tab" aria-selected="false">HTML</button>
          <button class="tab-btn" type="button" data-tab="full" role="tab" aria-selected="false">Completo (HTML + CSS)</button>
          <button class="tab-btn" type="button" data-tab="tailwind" role="tab" aria-selected="false">Tailwind CSS</button>
        </div>
        <button class="copy-button" type="button" data-copy aria-label="Copiar código actual al portapapeles">
          <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span data-copy-text>Copiar</span>
        </button>
      </div>

      <div class="code-view" data-code-view="css">
        <pre><code data-code-css>{initialCss}</code></pre>
      </div>
      <div class="code-view" data-code-view="html" hidden>
        <pre><code data-code-html>{animation.htmlSnippet}</code></pre>
      </div>
      <div class="code-view" data-code-view="full" hidden>
        <pre><code data-code-full>{initialFullExample}</code></pre>
      </div>
      <div class="code-view" data-code-view="tailwind" hidden>
        <pre><code data-code-tailwind>{initialTailwind}</code></pre>
      </div>

      <p class="copy-status" data-copy-status aria-live="polite"></p>
    </div>
  </div>
</article>
