---
// Header.astro — Barra superior de navegación y controles globales de accesibilidad / tema
---

<header class="topbar">
  <a class="brand" href="#inicio" aria-label="CSS Motion Lab, ir al inicio">
    <span class="brand-mark" aria-hidden="true">
      <i class="bar-1"></i>
      <i class="bar-2"></i>
      <i class="bar-3"></i>
    </span>
    <span class="brand-text">CSS <strong>Motion Lab</strong></span>
  </a>

  <div class="topbar-actions">
    <button class="icon-toggle-btn" type="button" data-shortcuts-toggle aria-label="Ver atajos de teclado" title="Atajos de teclado (tecla ?)">
      <span class="shortcut-icon-circle" aria-hidden="true">?</span>
      <span class="btn-label-desktop">Atajos</span>
    </button>

    <button class="icon-toggle-btn" type="button" data-motion-toggle aria-label="Alternar reducción de movimiento" title="Alternar modo de movimiento reducido">
      <svg class="motion-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
      </svg>
      <span class="btn-label-desktop">Movimiento</span>
    </button>

    <button class="icon-toggle-btn" type="button" data-theme-toggle aria-label="Alternar tema claro y oscuro" title="Alternar tema">
      <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
      <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>

    <a class="github-link" href="https://github.com/HugoAdama/CSS_Motion_Lab" target="_blank" rel="noreferrer" aria-label="Ver repositorio en GitHub">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
      </svg>
      <span class="btn-label-desktop">GitHub</span>
      <span class="arrow-ext" aria-hidden="true">&nearr;</span>
    </a>
  </div>
</header>
